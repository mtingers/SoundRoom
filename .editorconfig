root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,js,mjs,cjs,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated bindings and audio fixtures are owned by their generators.
[{protocol/generated/**,portable/fixtures/**,Sources/SoundroomRemote/RemoteV3Descriptor.swift,Sources/SoundroomRemote/RemoteV3Models.swift,Sources/SoundroomRemote/RemoteAutomationWriteRanges.swift,Tests/SoundroomRemoteTests/RemoteV3EnumParityTests.swift}]
insert_final_newline = unset
trim_trailing_whitespace = unset
